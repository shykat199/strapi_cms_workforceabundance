{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "country": {
      "type": "customField",
      "customField": "plugin::strapi-country-select.country-select",
      "required": true
    },
    "reading_time": {
      "type": "integer",
      "required": true,
      "default": 8
    },
    "published_time": {
      "type": "date",
      "required": true
    },
    "time": {
      "type": "string"
    },
    "summary": {
      "type": "richtext",
      "required": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "image_alt_text": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_keyword": {
      "type": "string"
    },
    "seo_description": {
      "type": "text"
    },
    "content_blocks": {
      "type": "dynamiczone",
      "components": [
        "blog.blog-content",
        "blog.faq"
      ]
    },
    "scheduled_at": {
      "type": "datetime"
    }
  }
}
